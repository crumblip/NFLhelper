# Props provider. Only ParlayAPI is implemented today; the adapter interface
# lets a second provider slot in without touching the pipeline.
PROPS_PROVIDER=parlay
PARLAY_API_KEY=

# League settings. These drive the FFC ADP endpoint and the baseline curve fit,
# so changing them invalidates adp_baseline.
SCORING_FORMAT=half-ppr
LEAGUE_TEAMS=12
SEASON=2026

# Yahoo league connection (optional). Without it the waiver wire decides who is
# available from national ADP, which is a proxy and is wrong in both directions
# for any real league.
#
# Register an app at https://developer.yahoo.com/apps/create/ with Fantasy
# Sports READ permission. The redirect URI must be HTTPS and Yahoo rejects a
# bare localhost — but it never has to load, because the authorization code
# appears in the address bar either way.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:3000/api/yahoo/callback
# Filled in for you by `npm run yahoo:auth`, which lists the leagues you are in.
YAHOO_LEAGUE_KEY=
